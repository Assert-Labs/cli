{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CLAUDE_PLUGIN_ROOT}/log.sh\" cursor sessionStart"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CLAUDE_PLUGIN_ROOT}/log.sh\" cursor beforeSubmitPrompt"
      }
    ],
    "preToolUse": [
      {
        "command": "\"${CLAUDE_PLUGIN_ROOT}/log.sh\" cursor preToolUse"
      }
    ],
    "postToolUse": [
      {
        "command": "\"${CLAUDE_PLUGIN_ROOT}/log.sh\" cursor postToolUse"
      }
    ],
    "afterFileEdit": [
      {
        "command": "\"${CLAUDE_PLUGIN_ROOT}/log.sh\" cursor afterFileEdit"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "\"${CLAUDE_PLUGIN_ROOT}/log.sh\" cursor afterAgentResponse"
      }
    ],
    "stop": [
      {
        "command": "\"${CLAUDE_PLUGIN_ROOT}/log.sh\" cursor stop"
      }
    ],
    "sessionEnd": [
      {
        "command": "\"${CLAUDE_PLUGIN_ROOT}/log.sh\" cursor sessionEnd"
      }
    ]
  }
}
